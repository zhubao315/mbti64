{
  "name": "64-personalities-cn",
  "version": "0.1.0",
  "private": true,
  "description": "64 型人格稀有度测评（64 Personalities CN）— 中文本土化心理测评 Demo",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-local.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:personality": "node scripts/audit-personality-data.mjs",
    "verify": "npm run audit:personality && npm run lint && npm run typecheck && npm test && npm run build",
    "assets:stash": "node scripts/assets-hifi.mjs stash",
    "assets:restore": "node scripts/assets-hifi.mjs restore",
    "assets:status": "node scripts/assets-hifi.mjs status",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "lighthouse": "node scripts/lighthouse.mjs",
    "book:split": "node scripts/split-book-data.mjs",
    "predev": "node scripts/split-book-data.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^11.11.17",
    "next": "14.2.15",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^20.16.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^4.6.7"
  }
}
